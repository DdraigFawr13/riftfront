{
  "name": "riftfront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "sample": "node --experimental-strip-types --no-warnings scripts/sample-match.ts",
    "sim": "node --experimental-strip-types --no-warnings scripts/sim.ts",
    "cards": "node --experimental-strip-types --no-warnings scripts/cards.ts",
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
